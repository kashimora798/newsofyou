# ─────────────────────────────────────────────────────────────────────────────
# NewsOfYou / Love Twin — environment reference
#
# ⚠️  Nothing here is committed with real values. Two very different groups:
#
#   A. VITE_*      → shipped in the browser bundle. Never put a secret here.
#   B. Edge-function secrets → set with `supabase secrets set NAME=value`.
#      They never reach the client; the router reads them via Deno.env.get().
# ─────────────────────────────────────────────────────────────────────────────

# ── A. Frontend (Vite, public) ───────────────────────────────────────────────
# The Supabase URL + anon key are already hard-coded in
# src/integrations/supabase/client.ts (Lovable convention). These are optional
# overrides used by a couple of hooks (useOnlineStatus, GifPicker).
VITE_SUPABASE_URL=https://itjukxjshcobpibmbrzq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...   # anon key — public by design
VITE_GIPHY_API_KEY=                            # optional Giphy picker

# ── B1. LLM providers (Phase 0 router: supabase/functions/_shared/models.ts) ─
# Private chat content is ONLY ever sent to providers flagged noTrain: true.
# Verify each provider's current data-use terms before trusting that flag.
GROQ_API_KEY=            # noTrain — REQUIRED for private traffic (fast free tier)
CEREBRAS_API_KEY=        # noTrain — optional fallback (large free daily quota)
CF_API_TOKEN=            # noTrain — optional fallback (Cloudflare Workers AI)
CF_ACCOUNT_ID=           # required together with CF_API_TOKEN
GEMINI_API_KEY=          # low-sensitivity only: free tier may be human-reviewed
OPENROUTER_API_KEY=      # low-sensitivity only: community `:free` models

# ── B2. Router tunables (all optional) ──────────────────────────────────────
LLM_DAILY_TOKEN_BUDGET=60000       # tokens/day across providers, then answers degrade
LLM_DISABLED_PROVIDERS=            # csv, e.g. gemini,openrouter
LLM_PREFER_PROVIDER=groq           # bias the chain (still falls back)
LLM_ROUTES_JSON=                   # {"twin_chat":[{"provider":"groq","model":"llama-3.3-70b-versatile"}]}
AI_REQUIRE_AUTH=true               # false lets anonymous callers use game helpers

# ── B3. Twin pipeline (Phase 1) ─────────────────────────────────────────────
EMBED_SECRET=                      # optional ≥16 chars; lets scripts/embed-backfill.mjs
                                   # authenticate without the service-role key

# ── B4. Automatically provided by the Supabase runtime (do NOT set manually) ─
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_DB_URL, SUPABASE_JWT_SECRET

# ── C. Local-only tooling (never deployed) ──────────────────────────────────
# Used by scripts/embed-backfill.mjs when run from your machine:
#   SUPABASE_URL=https://itjukxjshcobpibmbrzq.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=eyJ...     (service role — server-side only)
